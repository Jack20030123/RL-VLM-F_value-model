#!/bin/bash
#SBATCH --account=biyik_1165
#SBATCH --partition=gpu
#SBATCH --gpus-per-task=1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=120G
#SBATCH --time=48:00:00
#SBATCH --job-name=passwat_bsmooth_h20_s0
#SBATCH --output=logs/%x-%j.out

export RLVLMF_TASK_ENV=softgym_PassWater
export RLVLMF_METHOD=baseline
export RLVLMF_EXP_NAME=baseline_smooth_gemini_freeform_ep8000_step20_allimages_matched_seed0_passwater
export RLVLMF_USE_SMOOTH_RELABEL=1
export RLVLMF_SMOOTH_WINDOW=5
export RLVLMF_USE_EPISODE=true
export RLVLMF_MAX_EPISODE_STEPS=20
export RLVLMF_IMAGE_REPLAY_CAPACITY_EPISODES=8000
export RLVLMF_NUM_TRAIN_EPISODES=8000
export RLVLMF_NUM_SEED_EPISODES=14
export RLVLMF_NUM_UNSUP_EPISODES=120
export RLVLMF_NUM_INTERACT_EPISODES=67
export RLVLMF_EVAL_EPISODE_FREQUENCY=133
export RLVLMF_SAVE_EPISODE_INTERVAL=200
export RLVLMF_VIDEO_EPISODE_INTERVAL=200
export RLVLMF_NUM_TRAIN_STEPS=160000
export RLVLMF_NUM_SEED_STEPS=280
export RLVLMF_NUM_UNSUP_STEPS=2400
export RLVLMF_NUM_INTERACT=1340
export RLVLMF_EVAL_FREQUENCY=2660
export RLVLMF_SAVE_INTERVAL=4000
export RLVLMF_REWARD_BATCH=100
export RLVLMF_REWARD_UPDATE=30
export RLVLMF_REWARD_LR=1e-4
export RLVLMF_MAX_FEEDBACK=20000
